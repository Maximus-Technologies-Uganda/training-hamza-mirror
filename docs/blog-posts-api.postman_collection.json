                  "    pm.test('Response has required fields', () => {",
                  "        pm.expect(response).to.have.property('id');",
                  "        pm.expect(response).to.have.property('title');",
                  "        pm.expect(response).to.have.property('slug');",
                  "        pm.expect(response).to.have.property('body');",
