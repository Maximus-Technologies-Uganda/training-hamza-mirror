# Blog Posts API Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Storage Configuration
# Options: memory, sqlite, firestore
STORAGE_TYPE=memory
SQLITE_DB_PATH=./data/blog.db

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Trust Proxy (set to true when behind a reverse proxy like Cloud Run)
TRUST_PROXY=false

# JWT Authentication (REQUIRED for production)
# Must be at least 32 characters long for HS256 algorithm
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-min-32-chars-long-change-in-production

# Google Cloud Configuration (required when STORAGE_TYPE=firestore)
# GCP_PROJECT_ID=your-project-id
# FIRESTORE_COLLECTION=posts
